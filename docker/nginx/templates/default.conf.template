server {
    listen       8080;
    server_name  $SERVER;
    root   /var/www/html/app/$APP_DIRECTORY/public;
    port_in_redirect off;

    # rewrite_log on;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    index index.html index.html index.php;

    charset utf-8;

    location / {
        deny  all;
    }

    location /$APP_DIRECTORY {
        alias /var/www/html/app/$APP_DIRECTORY/public;
        if ($uri !~ "\/$APP_DIRECTORY\/.+\.(php|js|css|woff|woff2|html|ttf)$") {
            rewrite ^/$APP_DIRECTORY/(.*)$ /$APP_DIRECTORY/index.php;
        }
        try_files $uri $uri/ /$APP_DIRECTORY/index.php?$query_string;

        location ~ ^/$APP_DIRECTORY/index\.php$ {
            # access_log  /proc/self/fd/1  scripts;

            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass   app:9000;
            fastcgi_index  index.php;
            include        fastcgi_params;
            fastcgi_param  SCRIPT_FILENAME  /var/www/html/app/$APP_DIRECTORY/public/index.php;
            # fastcgi_param  HTTPS            $fastcgi_param_https_variable;
        }
    }

    error_page  404              /$APP_DIRECTORY/index.php;

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /$APP_DIRECTORY/index.php;

    # deny access to .htaccess files, if Apache's document root
    # concurs with nginx's one
    #
    location ~ /\.ht {
        deny  all;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
